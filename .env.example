# GEMINI_API_KEY: Used server-side for Kritika's Hindi/Hinglish & English TTS voice notes.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Required server-side for Kritika's OpenRouter chat brain.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: Default OpenRouter model ID (can also be changed in Studio UI).
OPENROUTER_MODEL="cognitivecomputations/dolphin-mistral-24b-venice-edition:free"

# TELEGRAM_BOT_TOKEN: Bot token from @BotFather.
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# TELEGRAM_WEBHOOK_SECRET: Optional secret token header to verify incoming Telegram webhooks.
TELEGRAM_WEBHOOK_SECRET="MY_TELEGRAM_WEBHOOK_SECRET"

# TENOR_API_KEY: Optional Tenor API key for dynamic GIF search (falls back to built-in GIF library).
TENOR_API_KEY=""

# APP_URL: Public base URL where this app is hosted (used for Telegram webhook registration).
APP_URL="MY_APP_URL"
